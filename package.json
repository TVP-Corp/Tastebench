{
  "name": "rating-rooms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-rating-rooms",
    "test:emu": "firebase emulators:exec --only auth,firestore --project demo-rating-rooms \"vitest run --config vitest.emu.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-rating-rooms \"playwright test\""
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "firebase": "13.4.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "firebase-tools": "15.37.0",
    "jsdom": "31.0.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
